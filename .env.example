# Configuração do Publicador Autônomo Diário do Blog TCAI Corp
# Copie este arquivo para .env na raiz do servidor (nunca comite o .env real)

# Chave da API Google Gemini (usada por blog/cron_publish.php para geração editorial diária)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# Segredo para disparo autenticado via HTTP Cron (ex: ?secret=SEU_SEGREDO_FORTE)
BLOG_CRON_SECRET="SEU_SEGREDO_FORTE_AQUI"

